#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        ComboLshift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <13 24>;
        };

        ComboLctrl {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <12 23>;
        };

        CmbLalt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <11 22>;
        };

        CmbRshift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <16 27>;
        };

        CmbRctrl {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <17 28>;
        };

        CmbRalt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <18 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
            &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y         &kp U            &kp I      &kp O    &kp P
            &kp A  &kp S  &kp D     &kp F  &kp G        &kp H         &kp J            &kp K      &kp L    &kp SEMI
&kp ESCAPE  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N         &kp M            &kp COMMA  &kp DOT  &kp FSLH  &kp APOS
                          &kp LGUI  &mo 1  &kp SPACE    &kp KP_ENTER  &lt 2 BACKSPACE  &mo 3
            >;
        };

        nav_num {
            bindings = <
           &msc SCRL_UP    &mkp MB1        &mmv MOVE_UP    &mkp MB2         &kp HOME         &none  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK
           &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp PAGE_DOWN    &none  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS
&kp GRAVE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &none            &none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp FSLH      &kp KP_PLUS
                                           &trans          &trans           &trans           &none  &kp NUMBER_0  &kp PERIOD
            >;
        };

        sym_func {
            bindings = <
           &kp F12  &kp F7  &kp F8  &kp F9  &kp LEFT_BRACE          &kp RIGHT_BRACE        &mkp MB1        &mmv MOVE_UP    &mkp MB2         &msc SCRL_UP
           &kp F11  &kp F4  &kp F5  &kp F6  &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN
&kp GRAVE  &kp F10  &kp F1  &kp F2  &kp F3  &kp LEFT_BRACKET        &kp RIGHT_BRACKET      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW     &kp RIGHT_ARROW  &kp HOME
                            &trans  &trans  &trans                  &none                  &none           &none
            >;
        };

        device {
            bindings = <
       &none       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none    &none         &none         &none         &none         &none
&none  &none       &none                 &none                 &none             &none    &none         &none         &none         &none         &none         &bt BT_CLR
                                         &none                 &none             &none    &none         &none         &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
